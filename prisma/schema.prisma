  @@index([resourceSemanticType])
  @@index([legalAuthorityKind])
  @@index([sourceCharacter])
  @@index([status])
  @@index([role])
  @@index([legalRank])
  @@index([territorialScope])
  @@index([confidence])
  @@index([isConformative])
  @@index([isExtractable])
  @@index([enteId])
  @@index([portId])
  @@index([effectiveFrom])
  @@index([createdAt])
