/// A legal/textual expression within a canonical LegalSource family.
model LegalExpressionVersion {
  id                    String   @id @default(cuid())
  sourceFamilyId        String
  expressionKey         String
  publicationDate       DateTime?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  expressionStatus      String?
  correctionMetadata    Json?
  consolidationMetadata Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sourceFamily   LegalSource          @relation(fields: [sourceFamilyId], references: [id], onDelete: Restrict)
  representations LegalSourceVersion[]
  temporalAssessments LegalSourceTemporalAssessment[]

  @@unique([sourceFamilyId, expressionKey])
  @@unique([id, sourceFamilyId])
  @@index([sourceFamilyId, effectiveFrom])
  @@index([effectiveTo])
}

/// An immutable evaluation event produced by the versioned temporal evaluator.
model LegalSourceTemporalAssessment {
  id                       String   @id @default(cuid())
  sourceFamilyId           String
  legalExpressionVersionId String
  assessmentVersion        String   @db.VarChar(100)
  referenceDate            DateTime
  validityState            String   @db.VarChar(50)
  temporalWindowState      String   @db.VarChar(50)
  applicabilityState       String   @db.VarChar(50)
  reasonCodes              Json
  effectiveFromSnapshot    DateTime?
  effectiveToSnapshot      DateTime?
  humanReviewRequired      Boolean
  confidence               String   @db.VarChar(20)
  inputFingerprint         String   @db.Char(64)
  createdAt                DateTime @default(now())

  sourceFamily          LegalSource            @relation(fields: [sourceFamilyId], references: [id], onDelete: Restrict)
  legalExpressionVersion LegalExpressionVersion @relation(fields: [legalExpressionVersionId, sourceFamilyId], references: [id, sourceFamilyId], onDelete: Restrict)
  researchSourceAssessments ResearchSourceAssessmentRecord[]

  @@unique([inputFingerprint], map: "temporal_assessment_identity_uq")
  @@index([legalExpressionVersionId, referenceDate, createdAt], map: "temporal_assessment_latest_idx")
  @@index([sourceFamilyId], map: "temporal_assessment_family_idx")
}

/// Provider-independent evidence supporting a canonical family identity.
model LegalSourceIdentityAssertion {
  id                   String                                @id @default(cuid())
  sourceFamilyId       String
  identifierScheme     String
  rawValue             String?
  normalizedValue      String
  issuingAuthority     String?
  jurisdiction         String?
  verificationStatus   LegalSourceIdentityVerificationStatus @default(UNVERIFIED)
  provenanceReference  String
  verifiedAt            DateTime?
  createdAt             DateTime                              @default(now())

  sourceFamily LegalSource @relation(fields: [sourceFamilyId], references: [id], onDelete: Restrict)

  @@index([sourceFamilyId, identifierScheme, normalizedValue], map: "LegalSourceIdentityAssertion_sourceFamilyId_identifierScheme_no")
  @@unique([sourceFamilyId, identifierScheme, normalizedValue], map: "legal_source_identity_assertion_identity_uq")
  @@index([identifierScheme, normalizedValue], map: "LegalSourceIdentityAssertion_identifierScheme_normalizedValue_i")
  @@index([verificationStatus])
}

/// An artifact/byte representation; temporal fields remain legacy compatibility metadata.
model LegalSourceVersion {
  id                   String                            @id @default(cuid())
  sourceFamilyId       String
  legalExpressionVersionId String?
  observedSha256       String                            @db.Char(64)
  observedSizeBytes    Int
  observedMimeType     String
  versionLabel         String?
  publicationDate      DateTime?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  legalLifecycleStatus LegalSourceVersionLifecycleStatus
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  sourceFamily           LegalSource                    @relation(fields: [sourceFamilyId], references: [id], onDelete: Restrict)
  legalExpressionVersion LegalExpressionVersion?        @relation(fields: [legalExpressionVersionId, sourceFamilyId], references: [id, sourceFamilyId], onDelete: Restrict)
  acquisitions           LegalSourceAcquisition[]
  legacyNormaVersioni    NormaVersione[]
  researchSourceAssessments ResearchSourceAssessmentRecord[]

  @@unique([sourceFamilyId, observedSha256])
  @@unique([id, sourceFamilyId])
  @@unique([id, sourceFamilyId, observedSha256])
  @@index([legalExpressionVersionId])
  @@index([sourceFamilyId, legalLifecycleStatus])
  @@index([effectiveFrom])
  @@index([effectiveTo])
}

