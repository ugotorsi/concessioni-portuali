}

model AiFascicoloHumanReviewState {
  id                String                               @id @default(cuid())
  materialId        String
  enteId            String
  procedimentoId    String
  statementPath     String
  version           Int                                  @default(0)
  latestDisposition AiFascicoloHumanReviewDisposition?
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt

  material AiFascicoloTrustedReviewMaterial @relation(fields: [materialId, enteId, procedimentoId], references: [id, enteId, procedimentoId], onDelete: Restrict)
  ente         Ente                           @relation(fields: [enteId], references: [id], onDelete: Restrict)
  procedimento Procedimento                   @relation(fields: [procedimentoId], references: [id], onDelete: Restrict)
  events       AiFascicoloHumanReviewEvent[]

  @@unique([materialId, statementPath])
  @@unique([id, materialId, statementPath, enteId, procedimentoId])
  @@index([enteId, procedimentoId])
}

model AiFascicoloHumanReviewEvent {
  id                 String                               @id @default(cuid())
  stateId            String
  materialId         String
  enteId             String
  procedimentoId     String
  statementPath      String
  sequence           Int
  disposition        AiFascicoloHumanReviewDisposition
  humanUserId        String
  actorIdSnapshot    String
  actorEmailSnapshot String
  actorRoleSnapshot  String
  occurredAt         DateTime
  createdAt          DateTime                             @default(now())
  note               String?
  reason             String?
  amendmentText      String?
  idempotencyKey     String
  commandFingerprint String

  state AiFascicoloHumanReviewState @relation(fields: [stateId, materialId, statementPath, enteId, procedimentoId], references: [id, materialId, statementPath, enteId, procedimentoId], onDelete: Restrict)
  ente         Ente         @relation(fields: [enteId], references: [id], onDelete: Restrict)
  procedimento Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Restrict)
  humanUser    User         @relation(fields: [humanUserId], references: [id], onDelete: Restrict)

  @@unique([materialId, statementPath, sequence])
  @@unique([enteId, idempotencyKey])
  @@index([enteId, procedimentoId])
}
