model Ente {
  id                           String                                 @id @default(cuid())
  nome                         String
  codice                       String                                 @unique
  tipo                         EnteTipo                               @default(ALTRO)
  stato                        EnteStato                              @default(ATTIVO)
  createdAt                    DateTime                               @default(now())
  updatedAt                    DateTime                               @updatedAt
  concessioni                  Concessione[]
  documenti                    Documento[]
  report                       Report[]
  activityLog                  ActivityLog[]
  memberships                  TenantMembership[]
  ports                        Port[]
  legalSources                 LegalSource[]
  legalRules                   LegalRule[]
  documentGaps                 DocumentGap[]
  importRuns                   ImportRun[]
  decisioniProcedimento        DecisioneProcedimento[]
  fascicoloObservations        FascicoloObservation[]
  checklistEvidence            FascicoloChecklistEvidence[]
  documentRequirementProposals FascicoloDocumentRequirementProposal[]
  documentRequirementEvidence  FascicoloDocumentRequirementEvidence[]
  documentFileVersions         DocumentFileVersion[]
  legalSourceAcquisitions      LegalSourceAcquisition[]
  neutralIntakes               NeutralIntake[]
  legalSourceCandidateAdmissions LegalSourceCandidateAdmission[]
  asyncJobs                    AsyncJob[]
  fascicoloSignals             FascicoloSignal[]
  concessioneExpiryChangeCommands ConcessioneExpiryChangeCommand[]
  researchMissions             ResearchMissionRecord[]
  researchAssistedVerifications ResearchAssistedVerificationRecord[]
  aiFascicoloTrustedReviewMaterials AiFascicoloTrustedReviewMaterial[]
  automaticFascicoloReports         AutomaticFascicoloReport[]
  documentExtractionAttempts        DocumentExtractionAttempt[]
  fascicoliIntake                   FascicoloIntake[]
  procedimenti                      Procedimento[]
  aiFascicoloHumanReviewStates      AiFascicoloHumanReviewState[]
  aiFascicoloHumanReviewEvents      AiFascicoloHumanReviewEvent[]
  fascicoloKnowledgeRevisions       FascicoloKnowledgeRevision[]
  fascicoloKnowledgeItems           FascicoloKnowledgeItem[]
  fascicoloKnowledgeEvidence        FascicoloKnowledgeEvidence[]
  fascicoloKnowledgeRelations       FascicoloKnowledgeRelation[]
  fascicoloSubjects                 FascicoloSubject[]
  structuredFascicoloReports        StructuredFascicoloReportSnapshot[]
  fascicoloOperationalProposals     FascicoloOperationalProposal[]
  runtimeBudgetPolicies             RuntimeBudgetPolicy[]
  runtimeCostReservations           RuntimeCostReservation[]

  @@index([tipo])
  @@index([stato])
  @@index([createdAt])
}

model Authority {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  level     AuthorityLevel @default(ALTRO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  ports        Port[]
  legalSources LegalSource[]
  importRuns   ImportRun[]

  @@index([level])
  @@index([createdAt])
}

model Port {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  enteId      String?
  authorityId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ente         Ente?         @relation(fields: [enteId], references: [id], onDelete: SetNull)
  authority    Authority?    @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  areas        PortArea[]
  legalSources LegalSource[]
  legalRules   LegalRule[]
  documentGaps DocumentGap[]
  importRuns   ImportRun[]

  @@index([enteId])
  @@index([authorityId])
  @@index([createdAt])
}

model PortArea {
  id        String   @id @default(cuid())
  portId    String
  code      String
  name      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  port Port @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@unique([portId, code])
  @@index([portId])
  @@index([createdAt])
}

model ImportRun {
  id            String          @id @default(cuid())
  packCode      String
  packVersion   String
  manifestPath  String
  status        ImportRunStatus @default(IN_PROGRESS)
  sourceCount   Int             @default(0)
  ruleCount     Int             @default(0)
  relationCount Int             @default(0)
  gapCount      Int             @default(0)
  warnings      Json?
  errorMessage  String?
  enteId        String?
  authorityId   String?
  portId        String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ente         Ente?         @relation(fields: [enteId], references: [id], onDelete: SetNull)
  authority    Authority?    @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  port         Port?         @relation(fields: [portId], references: [id], onDelete: SetNull)
  legalSources LegalSource[]
  legalSourceAcquisitions LegalSourceAcquisition[]

  @@index([packCode])
  @@index([status])
  @@index([enteId])
  @@index([createdAt])
}

model LegalSource {
  id                   String                @id @default(cuid())
  sourceKey            String                @unique
  title                String
  sourceType           LegalSourceType
  resourceSemanticType ResourceSemanticType?
  legalAuthorityKind   LegalAuthorityKind?
  sourceCharacter      SourceCharacter?
  status               LegalSourceStatus     @default(CURRENT_SUBJECT_TO_REVIEW)
  role                 LegalSourceRole       @default(NORMATIVE)
  legalRank            LegalRank             @default(OTHER)
  territorialScope     LegalTerritorialScope @default(AUTHORITY)
  confidence           LegalSourceConfidence @default(MEDIUM)
  issuingBody          String?
  sourceNumber         String?
  sourceDate           DateTime?
  sourceOrigin         String?
  portAreaCode         String?
  tags                 Json?
  humanReviewRequired  Boolean               @default(true)
  isConformative       Boolean               @default(true)
  isExtractable        Boolean               @default(true)
  duplicateOfSourceKey String?
  publicationDate      DateTime?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  notes                String?
  fileName             String?
  filePath             String?
  fileChecksumSha256   String?
  fileMimeType         String?
  fileSizeBytes        Int?
  enteId               String?
  authorityId          String?
  portId               String?
  importRunId          String?
  identityNamespace    String?
  identityScopeKind    LegalSourceIdentityScopeKind?
  identityScopeKey     String?
  canonicalKey         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  ente                         Ente?                                  @relation(fields: [enteId], references: [id], onDelete: SetNull)
  authority                    Authority?                             @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  port                         Port?                                  @relation(fields: [portId], references: [id], onDelete: SetNull)
  importRun                    ImportRun?                             @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  rules                        LegalRule[]
  documentRequirementProposals FascicoloDocumentRequirementProposal[]
  outgoingRelations            SourceRelation[]                       @relation("SourceRelationFrom")
  incomingRelations            SourceRelation[]                       @relation("SourceRelationTo")
  expressions                  LegalExpressionVersion[]
  versions                     LegalSourceVersion[]
  acquisitions                 LegalSourceAcquisition[]
