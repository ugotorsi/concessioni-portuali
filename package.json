    "worker:readiness": "tsx scripts/runtime/staging-readiness.ts",
    "check": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prepare": "npm run db:push && npm run db:seed",
