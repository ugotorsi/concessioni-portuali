    "db:normalize:legal-status:dry-run": "tsx scripts/db/normalize-legal-source-status.ts --dry-run",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset:demo": "prisma db push --force-reset && prisma db seed"
  },
