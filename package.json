{
  "name": "concessioni-portuali",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:async": "tsx src/server/async-jobs/applicationWorkerProcess.ts",
