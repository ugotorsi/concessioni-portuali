DATABASE_URL="postgresql://concessioni:concessioni@localhost:5433/concessioni_portuali?schema=public"
NEXTAUTH_SECRET="change-me-in-production"
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"
AUTH_PASSWORD_MIN_LENGTH="12"
MFA_ENCRYPTION_KEY=""
RATE_LIMIT_BACKEND="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
DOCUMENT_STORAGE_BACKEND="local"
DOCUMENT_STORAGE_ROOT=".local-storage/documents"
DOCUMENT_MAX_FILE_MB="15"
CONCESSIONE_EXPIRY_CHANGE_ENABLED="false"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Persistent application worker. Keep both allowlists empty only for a later
# explicitly authorized generalized rollout.
ASYNC_WORKER_ID=""
ASYNC_WORKER_CONCURRENCY="1"
ASYNC_WORKER_IDLE_BACKOFF_MS="1000"
ASYNC_WORKER_ERROR_BACKOFF_MS="5000"
ASYNC_WORKER_RETRY_DELAY_MS="30000"
ASYNC_WORKER_OPERATION_ALLOWLIST=""
ASYNC_WORKER_PROCEDIMENTO_ALLOWLIST=""
ASYNC_PROVIDER_EXECUTION_ENABLED="false"
ASYNC_COST_OPENAI_ANALYSIS_ESTIMATE_EUR=""
ASYNC_COST_RESEARCH_CALL_ESTIMATE_EUR=""
ASYNC_READINESS_REQUIRE_LIVE_WORKER="false"

# Automatic dossier analysis. All fields are required by the server runtime.
AI_REAL_DATA_ENABLED="false"
AI_REAL_DATA_APPROVAL_ID=""
AI_PROVIDER_PROJECT_CLASS=""
AI_OPENAI_API_KEY=""
AI_OPENAI_REGION=""
AI_OPENAI_TIMEOUT_MS=""
AI_OPENAI_MAX_RAW_RESPONSE_BYTES=""
AI_OPENAI_MAX_OUTPUT_TOKENS=""
AI_MAX_INPUT_BYTES=""

# Automatic preliminary research. Disabled unless every policy field is valid.
AUTOMATIC_RESEARCH_EXECUTION_ENABLED="false"
AUTOMATIC_RESEARCH_TENANT_ALLOWLIST=""
AUTOMATIC_RESEARCH_PROCEDIMENTO_ALLOWLIST=""
AUTOMATIC_RESEARCH_ALLOWED_CAPABILITIES=""
AUTOMATIC_RESEARCH_MAX_CALLS=""
AUTOMATIC_RESEARCH_WORKER_ACTOR_ID=""
AUTOMATIC_RESEARCH_LEASE_MS=""
AUTOMATIC_RESEARCH_PROVIDER_TIMEOUT_MS=""
LEGAL_DATA_HUNTER_API_KEY=""

# Paths inside the persistent worker host to mounted, access-restricted OAuth
# state files. Developer workstation files are not deployed automatically.
MOONLIT_OAUTH_STORAGE_PATH=""
SIMPLICITER_OAUTH_STORAGE_PATH=""

# WorkOS Standalone Connect for the remote MCP resource.
WORKOS_AUTHKIT_ISSUER="https://your-authkit-domain.workos.com"
WORKOS_API_KEY=""
MCP_RESOURCE_URI="https://your-production-domain.example/api/mcp"
MCP_FASCICOLO_GRANT_SECRET="replace-with-at-least-32-random-bytes"
MCP_FASCICOLO_GRANT_TTL_SECONDS="1800"

# Cloud demo (pilot preview, non-production)
# Do not commit real .env values.
# In cloud, do not use localhost values.
# Never use real or reserved data in the cloud demo database.
NEXTAUTH_URL="https://your-demo-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-strong-secret"
DATABASE_URL="postgresql://..."
RATE_LIMIT_BACKEND="memory"
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"
AUTH_PASSWORD_MIN_LENGTH="12"
MFA_ENCRYPTION_KEY=""
